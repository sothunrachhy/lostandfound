# Normalise line endings in the repository to LF regardless of the platform
# a contributor is on. Without this, core.autocrlf rewrites files on checkout
# and every file shows as modified on a different machine.
* text=auto eol=lf

# Binary assets must never be converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
