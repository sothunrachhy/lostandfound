{
  "name": "lf-system",
  "version": "2.0.0",
  "description": "Lost and Found Management System - Dual Portal Architecture",
  "main": "index.js",
  "scripts": {
    "build:client": "npm run build --prefix client",
    "build:admin": "npm run build --prefix admin",
    "build": "npm run build:client && npm run build:admin && npm run build:telegram",
    "dev:server": "node server/server.js",
    "dev:client": "npm run dev --prefix client",
    "dev:admin": "npm run dev --prefix admin",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\" \"npm run dev:telegram\"",
    "start": "node server/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "node server/scripts/setup.js",
    "db:hash-passwords": "node server/scripts/hashPasswords.js",
    "db:migrate-approval": "node server/scripts/migrateApproval.js",
    "db:reset-password": "node server/scripts/resetPassword.js",
    "dev:telegram": "npm run dev --prefix telegram",
    "build:telegram": "npm run build --prefix telegram",
    "db:migrate-telegram": "node server/scripts/migrateTelegram.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.27.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  }
}
